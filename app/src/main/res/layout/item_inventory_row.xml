<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/item_inv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Sample Name"
        android:textColor="@color/black"
        app:layout_constraintEnd_toStartOf="@+id/guideline_item_model"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_inv_model"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Sample Model"
        android:textColor="@color/black"
        app:layout_constraintEnd_toStartOf="@+id/guideline_item_serial"
        app:layout_constraintStart_toEndOf="@id/guideline_item_model"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_inv_serial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="SN00000"
        android:textColor="@color/black"
        app:layout_constraintEnd_toStartOf="@+id/guideline_item_status"
        app:layout_constraintStart_toEndOf="@id/guideline_item_serial"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_inv_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Available"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_item_status"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Guidelines for column separation within the item -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_item_model"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.25" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_item_serial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.50" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_item_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.75" />

</androidx.constraintlayout.widget.ConstraintLayout>
